---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  image?: string;
  preloadImage?: string;
}
const {
  title = 'Embedia — Componentes y SBC para sistemas embebidos',
  description = 'Compra microcontroladores, SBC, sensores y herramientas de laboratorio. Envío en 24h y pago con tarjeta u OXXO.',
  noindex = false,
  image = '/og-default.svg',
  preloadImage = '',
} = Astro.props;

const site = Astro.site ?? new URL('https://embedia.netlify.app');
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = new URL(image, site).toString();
const robots = noindex ? 'noindex,nofollow' : 'index,follow';

// [CHANGED] Preconnect al backend (para img/graphql cross-origin).
const backendOrigin = (() => {
  const raw = String(import.meta.env.PUBLIC_BACKEND_URL ?? '').trim();
  if (!raw) return '';
  try { return new URL(raw).origin; } catch { return ''; }
})();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', name: 'Embedia', url: site.toString(), logo: new URL('/favicon.svg', site).toString() },
    { '@type': 'WebSite', name: 'Embedia', url: site.toString() },
  ],
};
import { pwaInfo } from 'virtual:pwa-info';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ff6b1a" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Embedia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_MX" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {backendOrigin && <link rel="preconnect" href={backendOrigin} crossorigin />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      />
    </noscript>

    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
</head>
  <body class="min-h-screen bg-background text-foreground antialiased font-sans">
    <a href="#main" class="skip-link">Saltar al contenido</a>
    <slot />
  <script>
  import { registerSW } from "virtual:pwa-register";
  registerSW({ immediate: true });
</script>
</body>
</html>
