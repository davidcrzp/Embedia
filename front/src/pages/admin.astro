---
export const prerender = false;
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import AdminShell from '../components/AdminShell.astro';
import AdminApp from '../islands/AdminApp.tsx';
const usuario = Astro.locals.usuario!;
---
<Base title="Admin — Embedia" noindex>
  <TopBar />
  <main id="main" class="mx-auto max-w-[1400px] px-6 pt-10"><AdminShell nombre={usuario.nombre} rol={usuario.rol} /><AdminApp client:only="preact" /></main>
  <Footer />
</Base>
