# --- Servidor ---
PORT=4000
HOST=0.0.0.0

# --- Base de datos ---
# Local (docker-compose):
DATABASE_URL=postgres://embedia:embedia@localhost:5432/embedia
# Railway: se inyecta automáticamente al vincular el plugin Postgres.

# --- JWT / Cookies ---
JWT_SECRET=cambia-esto-por-un-secreto-de-32-o-mas-caracteres
JWT_EXPIRES_IN=7d
# Para usuarios usados por el MCP (larga vida, 1 año):
JWT_EXPIRES_IN_MCP=365d
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
# Producción (Railway + Netlify cross-origin):
# COOKIE_SECURE=true
# COOKIE_SAMESITE=None
# COOKIE_DOMAIN=

# Origen(es) permitidos por CORS (coma-separados). Vacío en dev = refleja el origen.
# Prod (Netlify):
# FRONTEND_ORIGIN=https://embedia.netlify.app

# --- Mercado Pago ---
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000
