# =========================================================
# Local (stdio via Claude Desktop / Cursor / VS Code)
# =========================================================
BACKEND_URL=http://localhost:4000
MCP_ADMIN_TOKEN=
MCP_ALLOW_WRITES=false
MCP_HTTP_TOKEN=
PORT=3333

# =========================================================
# Railway (HTTP mode)
# =========================================================
# BACKEND_URL=https://<railway-backend>.up.railway.app
# MCP_ADMIN_TOKEN=<jwt-de-1-año>            (obtener con: bun run login)
# MCP_ALLOW_WRITES=false                    (true solo si autorizas escrituras)
# MCP_HTTP_TOKEN=<bearer-aleatorio-32+>     (obligatorio en prod)
# PORT=<inyectado por Railway>              (no definir manualmente)
